{
  "name": "solid2-aria-monorepo",
  "private": true,
  "workspaces": [
    "./apps/*",
    "./packages/*",
    "./packages/@solid2-aria/*",
    "./packages/internal/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "check": "bun run check-solid2-names && bun run check-native-solid && bun run check-license-notices && turbo check && turbo check-compatibility",
    "check-license-notices": "node scripts/check-license-notices.mjs",
    "fix": "turbo fix",
    "check-types": "turbo check-types",
    "check-native-solid": "bun scripts/check-native-solid.ts",
    "check-solid2-names": "node scripts/check-solid2-names.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "eslint-plugin-de-morgan": "^2.3.0",
    "eslint-plugin-solid": "^0.18.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsrs": "^0.20.0-ts7.1.0-beta",
    "turbo": "^2.11.10",
    "typescript": "^7.1.0-beta",
    "ultracite": "8.0.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    }
  }
}
