{
  "name": "@solid2-aria/sonner",
  "version": "0.0.1",
  "private": false,
  "description": "Toast notifications for Solid 2, based on Sonner",
  "keywords": [
    "solid",
    "solid2-aria",
    "solidjs",
    "sonner"
  ],
  "license": "MIT",
  "author": {
    "name": "pekochan069",
    "email": "pekochan069@gmail.com",
    "url": "https://github.com/pekochan069/solid2-aria.git"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pekochan069/solid2-aria.git",
    "directory": "packages/solid2-sonner"
  },
  "files": [
    "dist",
    "LICENSE",
    "SONNER-LICENSE.md",
    "SOLID-SONNER-LICENSE.md",
    "NOTICE.txt",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/browser/index.d.ts",
      "browser": "./dist/browser/index.js",
      "default": "./dist/server/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "bun run build",
    "check-types": "tsrs --noEmit",
    "test": "bun test",
    "check-build": "bun scripts/check-build.ts",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@solidjs/compiler": "^2.0.0-rc.17",
    "@solidjs/web": "^2.0.0-rc.17",
    "@types/bun": "^1.4.4",
    "happy-dom": "^21.0.4",
    "solid-js": "^2.0.0-rc.17",
    "tsdown": "^0.23.2",
    "tsrs": "^0.20.0-ts7.1.0-beta",
    "typescript": "^7.1.0-beta"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.17",
    "solid-js": "^2.0.0-rc.17"
  }
}
